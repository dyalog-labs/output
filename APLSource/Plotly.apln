:Namespace Plotly

    ⎕IO←1 ⋄ ⎕ML←1                                 
 
    head←'<script src="https://cdn.plot.ly/plotly-3.6.0.min.js" charset="utf-8"></script>'

    color←{0≠80|⎕DR⍵:∇'#',⊃,/((⎕D,⎕A)⌷⍨∘⊂⎕IO+16 16∘⊤)¨⍵ ⋄ (color:⍵)}
    colors←color¨(  
        ⍝ https://github.com/plotly/plotly.js/blob/main/src/components/color/attributes.js
        '#1f77b4'  ⍝ muted blue
        '#ff7f0e'  ⍝ safety orange
        '#2ca02c'  ⍝ cooked asparagus green
        '#d62728'  ⍝ brick red
        '#9467bd'  ⍝ muted purple
        '#8c564b'  ⍝ chestnut brown
        '#e377c2'  ⍝ raspberry yogurt pink
        '#7f7f7f'  ⍝ middle gray
        '#bcbd22'  ⍝ curry yellow-green
        '#17becf'  ⍝ blue-teal
    )
    font←{0=⎕NC'⍺':(size:⍵) ⋄ (family:⍺ ⋄ size:⍵)}
    title←{(title:(text:⍵))}

    config←{326≡⎕DR ⍵:⍵ ⋄ 1=≢⍵:∇1(9÷16)×⊃⍵ ⋄ l←() ⋄ l⊣l.(width height)←2↑⍵}

    data←{
        ⍺←() ⋄ layout←⎕NS ⍺
        NS←{         
            0≠⍵.⎕NC'type':⍵ ⋄ n←⎕NS ⍵
            n.type←{
                ⍵:layout.type ⋄ 0≠n.⎕NC'z':'surface' ⋄ ⊃∧/0≠n.⎕NC¨'yx':'scatter'
                'bar'
            }0≠layout.⎕NC'type'
            n←{0≠n.⎕NC'mode':n ⋄ ~⍵:n ⋄ n.mode←layout.mode ⋄ n}0≠layout.⎕NC'mode'
            0∊80|⎕DR∊n ⎕VGET⊂(,'x')0:n ⎕NS(type:'bar' ⋄ orientation:'v')
            0∊80|⎕DR∊n ⎕VGET⊂(,'y')0:n ⎕NS(type:'bar' ⋄ orientation:'h')
            n
        } 
        (,326)≡∪⎕DR¨∊⍵:(layout⊣layout.⎕EX'type' 'mode')(NS¨⍵)
        pts←{(2=≡⍵)∧(1∧.=≡¨⍵)∧(2∧.=≢¨⍵)∨(0=80|⎕DR⊃⍵)∧2∧.=≢¨1↓⍵}
        inv←{0=80|⎕DR⊃⍵:(1↑⍵),∇1↓⍵ ⋄ ↓⍉↑⍵}
        box←{(type:'box' ⋄ name:⍺ ⋄ x:⍵ ⋄ showlegend:⊂'false')}
        (⍺ ⎕VGET⊂'barmode' 'group'){
            b←'box'≡layout ⎕VGET⊂'type' ''
            (2=|≡⍵)∧b∧0=80|⎕DR∊⊃⍵:layout((⊃⍵)box¨1↓⍵)⊣layout.⎕EX'type'
            (2=|≡⍵)∧b:layout((⍳≢⍵)box¨⍵)⊣layout.⎕EX'type'
            (2=≡⍵)∧0=≢⍴⍵:layout(type:'histogram' ⋄ x:⊃⍵)
            2=≢⍴⍵:layout(type:'surface' ⋄ z:↓⍵)
            1=≡⍵:layout(type:'bar' ⋄ y:⍵ ⋄ x:⍳≢⍵)
            (3=|≡⍵)∧0∧.=≢∘⍴¨1↓⍣(0=80|⎕DR∊⊃⍵)⊢⍵:∇⊃¨@(0≠80|⎕DR∘∊¨)⍵⊣layout ⎕NS←(type:'box')
            (3=≡⍵)∧∧/pts¨⍵:∇ inv¨⍵⊣layout ⎕NS←(mode:'markers')
            pts ⍵:∇ inv ⍵⊣layout ⎕NS←(mode:'markers')
            0=80|⎕DR∊⊃⍵:'stack'∇ ¯1(↓,(1↑⍵),↑)¨⊂¨⍣(2=≡1↓⍵)⊢1↓⍵
            ((1=≡)∨0=80|⎕DR∘∊)⊃⌽⍵:'stack'∇,∘(¯1↑⍵)¨⊂¨⍣(2=≡¯1↓⍵)⊢¯1↓⍵
            1=≡⊃⍵:∇ 1(↑,(1↑⍵),↓)¨⊂¨⍣(2=≡1↓⍵)⊢1↓⍵
            n←NS∘{n←() ⋄ n.(name y x)←¯3↑(⊂''),⍵ ⋄ n}¨⍵
            _←layout.⎕EX'type' 'mode'
            1≥+/n.type≡¨⊂'bar':layout n
            layout.barmode←⍺ ⋄ layout n
        }⍵
    }

    multidata←{
        ⍺←()
        
        ⍝ configuration and shape
        c←config ⍺ ⋄ r←¯2↑1,⍴⍵

        ⍝ set axis of each plot
        d←c(⊃∘⌽data)¨⍵
        d←{(xaxis:'x',⍕⍵ ⋄ yaxis:'y',⍕⍵)(⎕NS,)⍨¨⍵⊃d}¨⍳≢d←,r⍴d

        c ⎕NS←(grid:(rows:⊃r ⋄ columns:⊃⌽r ⋄ pattern:'independent'))
        c(d⍴⍨⍴⍵)
    }

    plot←{
        ⍺←()

        ⍝ non-namespace left argument
        layout ns←(config ⍺)data ⍵
        _←layout.⎕EX'type' 'mode'      

        ⍝ default layout
        default_layout←(
            barmode:'group'
            margin:(t:10 ⋄ b:40 ⋄ l:40 ⋄ r:10)
            xaxis:(automargin:⊂'true')
            yaxis:(automargin:⊂'true')
        )    
        sl←⊂'false'⊣⍣(0∧.=≢¨ns ⎕VGET(⊂'name' ''))⊢'true'
        default_layout ⎕VSET←⊂'showlegend' sl

        ⍝ style depending on fixed size or not
        style←'width:fit-content;margin:0 auto;overflow:auto'
        style←'width:92vw;height:92vh'⊣⍣(⊃0=layout.⎕NC'width')⊢style

        ⍝ json
        cfg←'{displaylogo:false, responsive:true}'
        data layout←⎕JSON¨(⌽,ns)(⎕NS default_layout,layout)

        ⍝ html
        get←'document.getElementById(''',(id←'plt-',120⌶4),''')'
        script←'Plotly.newPlot(',get,', ',data,', ',layout,', ',cfg,');'
        '<div id="',id,'" style="',style,'"></div><script>',script,'</script>'
    }

    multiplot←{⍺←⊢ ⋄ c d←⍺ multidata ⍵ ⋄ c plot⌽∊d}

:EndNamespace
