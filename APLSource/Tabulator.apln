:Namespace Tabulator

    ⎕IO←1 ⋄ ⎕ML←1

    head←'<link href="https://unpkg.com/tabulator-tables@6.4.0/dist/css/tabulator.min.css" rel="stylesheet">'
    head,←'<script type="text/javascript" src="https://unpkg.com/tabulator-tables@6.4.0/dist/js/tabulator.min.js"></script>'

      flip←{
          2=≢⍴⍵:↓⍵
          2≤|≡⍵:↓⍉↑⍵
          1=≡⍵:().⎕VSET↓⍉↑n(↓⍉↑⍵.⎕VGET⊂n←(⊃⍵).⎕NL ¯2)
          k v←↓⍉↑⍵.⎕VGET ¯2 ⋄ ⊢(⊂⍬)(⎕NS⍤⊣⎕VSET{↓⍉↑k ⍵})¨↓⍉↑v ⍝ namespace of vectors to vector of namespaces (!)
      }
      sort←{⍺←⊃⍵.⎕NL-2 ⋄ flip ⍺ ⍺⍺{⍵[⍺⍺ ⍵.⎕VGET⊂⍺]}flip ⍵}
      config←{
          default_config←(layout:'fitColumns')
          ⍺←{
              9.1=42 ⎕ATX'⍵':{(field:⍵ ⋄ title:⍵)}¨⍵.⎕NL ¯2
              2=≢⍴⍵:∇↓⍉⍵
              {(field:⍕⍵)}¨(⍳≢⍵)-⎕IO
          }⍵
          0∧.=80|⎕DR¨⍺:⍵∇⍨⍺{(field:⍕⍵ ⋄ title:⍺)}¨(⍳≢⍵)-⎕IO
          ⊃0∧.=⍺.⎕NC⊂'field':⍵∇⍨⍺⎕NS¨⍨{(field:⍕⍵)}¨(⍳≢⍵)-⎕IO
          ⍺{a←⍺
              0<⎕NC'a.columns':⎕NS default_config ⍺ ⍵
              ⎕NS default_config(columns:⍺)⍵
          }(data:flip ⍵)
      }
      table←{
          ⍺←⊢ ⋄ cfg←⎕JSON ⍺ config ⍵
          script←'var table = new Tabulator("#',(id←'tbl-',120⌶4),'", ',cfg,');'
          '<div id="',id,'"></div><script>',script,'</script>'
      }

:EndNamespace
